# ==========================================
# Voyara Environment Configuration
# ==========================================

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/voyara

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Destination Intelligence
# External destination provider

GEOAPIFY_API_KEY=your_geoapify_api_key_here
DESTINATION_PROVIDER=static

# Keep real API keys only inside backend/.env.